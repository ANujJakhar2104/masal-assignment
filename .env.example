# Postgres connection used by the app. On Neon, use the pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: direct (non-pooled) connection for `prisma migrate`. Falls back to DATABASE_URL.
DIRECT_URL=""

# Free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional: override the Gemini model.
GEMINI_MODEL=""
